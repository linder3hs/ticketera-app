# Copia este archivo a .env y completa los valores. Nunca subas .env a git.

# --- Neon (Postgres) ---
# Connection string de Neon (Dashboard > Connect). Incluye ?sslmode=require
DATABASE_URL=

# --- Clerk (https://dashboard.clerk.com > API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhooks > endpoint /api/webhooks/clerk > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# URL pública de la app: las invitaciones de Clerk aterrizan en {APP_URL}/sign-up (local: http://localhost:3000)
APP_URL=http://localhost:3000

# --- Stripe (https://dashboard.stripe.com/test/apikeys, claves de test) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhooks > endpoint /api/webhooks/stripe (local: `stripe listen`) > whsec_...
STRIPE_WEBHOOK_SECRET=

# --- Roles ---
# Correo (verificado en Clerk) que nace como super_admin. Único rol elevado que no se asigna desde la app.
SUPER_ADMIN_EMAIL=linderhassinger01@gmail.com
