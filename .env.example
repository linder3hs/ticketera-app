# Copia este archivo a .env y completa los valores. Nunca subas .env a git.

# --- Neon (Postgres) ---
# Connection string de Neon (Dashboard > Connect). Incluye ?sslmode=require
DATABASE_URL=

# --- Clerk (https://dashboard.clerk.com > API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhooks > endpoint /api/webhooks/clerk > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# URL pública de la app: las invitaciones de Clerk aterrizan en {APP_URL}/sign-up (local: http://localhost:3000)
APP_URL=http://localhost:3000

# --- Stripe (https://dashboard.stripe.com/test/apikeys, claves de test) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook de PAGOS (tarjeta 08): endpoint /api/webhooks/stripe (local: `stripe listen`) > whsec_...
STRIPE_WEBHOOK_SECRET=
# Secreto del webhook de Connect (thin events v2 de cuentas): endpoint /api/webhooks/stripe-connect > whsec_...
# Es distinto de STRIPE_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=
# País (ISO 3166-1 alfa-2, minúsculas) y moneda (ISO 4217, minúsculas) de la cuenta conectada.
# Sin valor por defecto en código: si faltan, el onboarding falla con un mensaje claro.
# Dependen de dónde esté disponible Connect (en test, el país de la plataforma).
STRIPE_CONNECT_ACCOUNT_COUNTRY=
STRIPE_CONNECT_ACCOUNT_CURRENCY=

# --- Roles ---
# Correo (verificado en Clerk) que nace como super_admin. Único rol elevado que no se asigna desde la app.
SUPER_ADMIN_EMAIL=linderhassinger01@gmail.com

# --- AWS S3 (portadas de eventos) ---
# Local: perfil del CLI con acceso al bucket; sin él el SDK firma con el perfil `default` y S3 responde 403.
# En la EC2 no va: el SDK usa el rol de la instancia.
AWS_PROFILE=ticketera
AWS_REGION=us-east-2
S3_COVERS_BUCKET=
# CloudFront sirve /covers/* desde el bucket (también en local: el bucket no tiene otro origen público)
COVERS_BASE_URL=https://d35ycaybluucd9.cloudfront.net/covers

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
# Remitente de los correos: el dominio debe estar verificado en Resend (Domains > DNS: SPF/DKIM)
RESEND_FROM_EMAIL=no-reply@ticketera.delabpe.com
